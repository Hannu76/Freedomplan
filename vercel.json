{
  "crons": [
    {
      "path": "/api/marketing/campaigns/send-weekly",
      "schedule": "0 9 * * 5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|images|assets|favicon|robots|sitemap|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
